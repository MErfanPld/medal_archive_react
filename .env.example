# مجموعه آثار ناصر صلب — Environment Variables
# Copy to .env.local for development. Never commit secrets.

# Client API base (no trailing slash).
# Leave EMPTY in local dev so the browser calls same-origin /api/*
# and Next.js rewrites to Django (see next.config.ts) — avoids CORS.
#
# Production / demo:
# NEXT_PUBLIC_API_URL=http://api.nasersolb.com
NEXT_PUBLIC_API_URL=

# Server-only: where Next proxies /api/* and /media/* (not exposed to browser)
API_PROXY_TARGET=http://127.0.0.1:8000

# Auth: real API is the DEFAULT.
# NEXT_PUBLIC_USE_MOCK_AUTH=1

# Data layer mock: real API is the DEFAULT.
# NEXT_PUBLIC_USE_MOCK_DATA=1
