# Medal Archive Pro - Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or real secrets.

# Backend API base URL (no trailing slash, no /api suffix)
# Paths already include /api/...
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Auth: real API is the DEFAULT.
# Set to 1 only if you want local mock login without backend.
# NEXT_PUBLIC_USE_MOCK_AUTH=1

# Data layer users/roles: real API is the DEFAULT.
# Set to 1 to force mock data for those services.
# NEXT_PUBLIC_USE_MOCK_DATA=1

# Optional
# NEXT_PUBLIC_APP_ENV=development
